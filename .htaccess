# =====================================================================
# HIS Objektmanagement – Einstellungen für das IONOS-Webhosting (Apache)
# =====================================================================

# Eigene Fehlerseite
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Versteckte Dateien und Ordner sperren (z. B. .git, .htaccess) – außer .well-known (SSL-Zertifikate)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Immer HTTPS und immer https://hisobjekt.de (Ziel fest eingetragen, nicht aus der Anfrage übernommen)
  # Hinweis Cloudflare: SSL/TLS-Modus in Cloudflare auf „Full (strict)“ stellen.
  # Im Modus „Flexible“ kommt die Anfrage per HTTP bei IONOS an und diese Regel erzeugt eine Weiterleitungsschleife.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^hisobjekt\.de$ [NC]
  RewriteRule ^ https://hisobjekt.de%{REQUEST_URI} [L,R=301]
</IfModule>

# Sicherheits-Header
# Die Content-Security-Policy erlaubt nur Inhalte vom eigenen Server und von Cookiebot. So kann nichts von
# anderen Drittanbietern (Google Fonts, Maps …) in den Browser geladen werden.
# Eingebettete Skripte sind nur per Prüfsumme erlaubt (die eine Zeile im <head> jeder Seite).
#   Wird diese Zeile geändert, muss die Prüfsumme neu berechnet werden:
#   printf "%s" "document.documentElement.classList.add('js');" | openssl dgst -sha256 -binary | base64
#   Falls das Cookiebot-Banner nach der Aktivierung blockiert wird, bei script-src 'unsafe-inline' ergänzen.
# Ein vorgeschaltetes CDN (z. B. Cloudflare) liefert über die eigene Domain aus und ist davon nicht betroffen.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu; frame-src https://consentcdn.cookiebot.com https://consentcdn.cookiebot.eu; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://imgsct.cookiebot.com https://imgsct.cookiebot.eu; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # Server-Software nicht preisgeben
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Browser-Cache: Schrift und Bilder lange, CSS/JS kurz (Änderungen kommen schnell an)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

AddType font/woff2 .woff2
